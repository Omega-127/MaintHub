# ─────────────────────────────────────────────
# MaintHub .gitignore
# ─────────────────────────────────────────────

# Environment & Secrets — NEVER commit real secrets or credentials
.env
.env.*
*.env
*.env.local
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets/
secrets.json
credentials.json
client_secret*.json

# Firebase & Cloud Credentials
firebase-credentials.json
**/google-services.json
**/GoogleService-Info.plist

# Signing & Release Keys
**/key.properties
**/*.jks
**/*.keystore

# Python & Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
pip-log.txt
pip-delete-this-directory.txt

# Flask / Backend & Databases
instance/
.webassets-cache
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Flutter & Dart (root or subdirectories)
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub/
**/.pub-cache/
# NOTE: commit pubspec.lock for apps (reproducible builds) — do not ignore it

# Android local configs, Gradle caches & builds
**/android/local.properties
**/android/.gradle/
**/android/captures/
**/android/.cxx/
**/android/.kotlin/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/GeneratedPluginRegistrant.*
**/*.apk
**/*.aab
**/*.ap_

# iOS (if generated by Flutter)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/.last_build_id
**/*.ipa
**/*.dSYM/
**/*.dSYM.zip

# Node & Web Tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel/

# Operating System Files
[Dd]esktop.ini
[Tt]humbs.db
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDE & Editor Files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
**/*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.directory

# Temporary Office / Spreadsheet Lock Files (generated when editing Excel)
~$*.xlsx
~$*.xls
~$*.doc*
~$*.ppt*

# Logs & Temporary Scripts
*.log
*.tmp
*.temp
generate_app_icons.py
build_id.txt
**/build_id.txt
